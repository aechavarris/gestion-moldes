# Copy to .env next to docker-compose.prod.yml on the host PC. Never commit it.
# Database password: do not change it after the first start.
POSTGRES_PASSWORD=
# Tailscale auth key (admin console > Settings > Keys). Used once to join the tailnet.
TS_AUTHKEY=
# Machine name: the app is served at https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=fichas
